<?xml version="1.0" encoding="utf-8"?>
<!-- 【M5】设置页：原「⚙ 设置」对话框的内容整体搬到这里（不再用对话框） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_group_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_brightness" />

        <SeekBar
            android:id="@+id/seekBrightness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_dash_speed" />

        <SeekBar
            android:id="@+id/seekDashSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120" />

        <Switch
            android:id="@+id/switchAnim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_anim" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_map"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/set_map_style" />

        <Spinner
            android:id="@+id/spMapStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_group_conn"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_host"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/setPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_port"
            android:inputType="number"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/setAutoConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_auto_connect" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_nav"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setFrom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_from"
            android:inputType="text"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/setTo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_to"
            android:inputType="text"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/setAutoCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_auto_city" />

        <EditText
            android:id="@+id/setCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_city"
            android:inputType="text"
            android:importantForAutofill="no" />

        <CheckBox
            android:id="@+id/setEmulate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_emulate" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_map"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setZoom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_zoom"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_overview"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/setSamplerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/setSamplerVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_overview_vw" />

            <RadioButton
                android:id="@+id/setSamplerDp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/set_overview_dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_esp_style"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/set_esp_hint" />

        <CheckBox
            android:id="@+id/setEspScrimOn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_esp_scrim" />

        <TextView
            android:id="@+id/tvEspScrimCompass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_scrim_compass" />

        <SeekBar
            android:id="@+id/seekEspScrimCompass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tvEspScrimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_scrim_text" />

        <SeekBar
            android:id="@+id/seekEspScrimText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tvEspScrimRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_scrim_route" />

        <SeekBar
            android:id="@+id/seekEspScrimRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tvEspScrimClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_scrim_clock" />

        <SeekBar
            android:id="@+id/seekEspScrimClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:id="@+id/tvEspGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_grid" />

        <SeekBar
            android:id="@+id/seekEspGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_debug"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/setDbgAllOff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dbg_all_off" />

        <CheckBox
            android:id="@+id/setDbgRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dbg_road" />

        <CheckBox
            android:id="@+id/setDbgCenterLn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dbg_centerln" />

        <CheckBox
            android:id="@+id/setDbgOverview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dbg_overview" />

        <CheckBox
            android:id="@+id/setDbgCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_dbg_car" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_log"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/setLogLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/set_hint_log"
            android:inputType="number"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_perm"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPermState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/set_perm_unknown" />

        <Button
            android:id="@+id/btnOpenAppSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_open_app_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_cfg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCfgState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/cfg_absent" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_esp_color"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="@string/set_esp_col_hint_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_main" />

        <Spinner
            android:id="@+id/spEspColMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_track" />

        <Spinner
            android:id="@+id/spEspColTrack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_grid" />

        <Spinner
            android:id="@+id/spEspColGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_road" />

        <Spinner
            android:id="@+id/spEspColRoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_car" />

        <Spinner
            android:id="@+id/spEspColCar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_col_hint" />

        <Spinner
            android:id="@+id/spEspColHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/setDbgTripCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/set_dbg_trip_card" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:text="@string/set_group_esp_map"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cbEspMapShot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_esp_map_shot" />

        <TextView
            android:id="@+id/tvEspMapShotInt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_map_shot_int" />

        <SeekBar
            android:id="@+id/seekEspMapShotInt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvEspMapBright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_map_bright" />

        <SeekBar
            android:id="@+id/seekEspMapBright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="120" />

        <TextView
            android:id="@+id/tvEspMapContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:text="@string/set_esp_map_contrast" />

        <SeekBar
            android:id="@+id/seekEspMapContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <CheckBox
            android:id="@+id/setScreenFlip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_screen_flip" />

        <Button
            android:id="@+id/btnCfgPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_grant" />

        <Button
            android:id="@+id/btnCfgSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_save" />

        <Button
            android:id="@+id/btnCfgLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_load" />

        <Button
            android:id="@+id/btnCfgDel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cfg_del" />

        <Button
            android:id="@+id/btnSettingsSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/btn_settings_save" />
    </LinearLayout>
</ScrollView>
